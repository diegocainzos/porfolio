---
const personalImageAlt = "Diego García Caínzos"
import Badge from "@/components/Badge.astro"
import FileCvIcon from "@/components/icons/FileCv.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SparklesIcon from "@/components/icons/Sparkles.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="max-w-xl">
  <div class="anim-fade-in flex gap-4 mb-6 items-center">
    <div class="relative flex-shrink-0">
      <div
        class="absolute inset-0 rounded-full bg-yellow-400/30 dark:bg-yellow-400/20 blur-xl scale-125"
        aria-hidden="true"
      >
      </div>
      <img
        class="relative rounded-full shadow-2xl size-20 ring-2 ring-yellow-400/60 ring-offset-2 ring-offset-gray-50 dark:ring-offset-gray-950"
        src="/photo.png"
        alt={personalImageAlt}
      />
    </div>
    <a
      href="https://linkedin.com/in/diegocainzos"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge><SparklesIcon class="size-3" /> Open to work</Badge>
    </a>
  </div>

  <h1
    class="anim-fade-in anim-delay-1 text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hey, I'm <span class="gradient-name">Diego</span> 👋
  </h1>

  <p
    class="anim-fade-in anim-delay-2 mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    <strong>Software & Data Engineer</strong> with a strong foundation in <strong>Artificial Intelligence
  and Deep Learning</strong>.
    My expertise spans across the entire data lifecycle: whether it's extracting insights from geospatial
  datasets,
    designing cloud architectures, or orchestrating LLM agents with LangGraph.
    <br>
   
    <strong>Trilingual (ES/EN/PT) </strong>and internationally tested. Looking for a first full-time challenge in
  <strong>Data or AI</strong>
    where I can bring immediate value. Open to remote and on-site roles.
  </p>

  <nav
    class="anim-fade-in anim-delay-3 flex flex-wrap gap-4 mt-8"
    aria-label="Social links and contact"
  >
    <SocialPill href="mailto:dgarciacainzos@gmail.com">
      <MailIcon class="size-4" />
      Reach me
    </SocialPill>
    <SocialPill href="/CV_Diego_Garcia_Cainzos.pdf">
      <FileCvIcon class="size-4 dark:text-white" />
      CV
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/diegocainzos">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>
